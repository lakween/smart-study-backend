# PostgreSQL connection string from Neon (or your own Postgres instance).
# Get one free at https://neon.tech -> Create Project -> Connection String (use the "Pooled connection" string).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random long secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# AI quiz provider: "openai" or "gemini". Restart the backend after changing it.
AI_PROVIDER="openai"

# OpenAI Platform API credentials.
OPENAI_API_KEY="replace-with-your-openai-api-key"
OPENAI_MODEL="gpt-5.6-terra"

# Google AI Studio Gemini credentials.
GEMINI_API_KEY="replace-with-your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"

# Server port
PORT=4000

# Comma-separated list of allowed CORS origins. "*" allows all (fine for local dev).
CORS_ORIGIN="*"

# Base URL this server is reachable at, used to build absolute file URLs (no trailing slash).
PUBLIC_BASE_URL="http://localhost:4000"
